{
  "name": "nutrithrive-website",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run storefront:migrate && node scripts/build-assets.mjs --skip-tailwind",
    "ci": "npm run build && node scripts/verify-storefront-migration.mjs && node scripts/verify-sitemap-locs.mjs && node scripts/verify-blog-itemlist.mjs && node scripts/blog-duplicate-scan.mjs && node scripts/prepare-netlify-publish.mjs",
    "deploy:prod": "npm run ci && netlify deploy --dir=.netlify-publish --prod",
    "build:tailwind": "tailwindcss -i ./site/assets/css/tailwind-v2-source.css -o ./site/assets/css/tailwind-v2.min.css --minify",
    "build:minify": "node scripts/build-assets.mjs --skip-tailwind",
    "hooks:install": "node scripts/install-git-hooks.mjs",
    "storefront:preview": "npm run ci",
    "storefront:migrate": "STOREFRONT_PRODUCTION=1 node storefront/build.mjs && node scripts/verify-storefront-migration.mjs",
    "storefront:verify": "node scripts/verify-storefront-migration.mjs",
    "storefront:serve": "node scripts/serve-storefront-preview.mjs",
    "blog:launch:apply": "node scripts/apply-blog-launch-schedule.mjs"
  },
  "dependencies": {
    "nodemailer": "^9.0.1"
  },
  "devDependencies": {
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.10",
    "clean-css": "^5.3.3",
    "esbuild": "^0.25.0",
    "fast-glob": "^3.3.3",
    "tailwindcss": "^3.4.17"
  },
  "overrides": {
    "postcss": "^8.5.18",
    "nanoid": "^3.3.18"
  }
}
