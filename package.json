{
  "name": "nutrithrive-website",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-assets.mjs",
    "ci": "npm run build:minify && node scripts/verify-sitemap-locs.mjs && node scripts/verify-blog-itemlist.mjs && node scripts/blog-duplicate-scan.mjs && node scripts/prepare-netlify-publish.mjs",
    "deploy:prod": "node scripts/prepare-netlify-publish.mjs && netlify deploy --dir=.netlify-publish --prod",
    "build:tailwind": "tailwindcss -i ./assets/css/tailwind-v2-source.css -o ./assets/css/tailwind-v2.min.css --minify",
    "build:minify": "node scripts/build-assets.mjs --skip-tailwind",
    "hooks:install": "node scripts/install-git-hooks.mjs",
    "ds-v1:preview": "node ds-v1/build.mjs",
    "ds-v1:live": "DS_V1_LIVE=1 node ds-v1/build.mjs && node scripts/verify-ds-v1-live.mjs",
    "blog:launch:apply": "node scripts/apply-blog-launch-schedule.mjs"
  },
  "dependencies": {
    "nodemailer": "^9.0.1"
  },
  "devDependencies": {
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.10",
    "clean-css": "^5.3.3",
    "esbuild": "^0.25.0",
    "fast-glob": "^3.3.3",
    "tailwindcss": "^3.4.17"
  },
  "overrides": {
    "postcss": "^8.5.18",
    "nanoid": "^3.3.18"
  }
}
